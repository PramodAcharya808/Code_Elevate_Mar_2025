CMD 1:

used to set username and email for authentication

git config --global user.name PramodAcharya808
git config --global user.email pramodacharya808@gmail.com


CMD 2: 

used to confirm the username and email

git config --global user.name
git config --global user.email

CMD 3:
Initialize git in desitination folder

git init
ls -lart

CMD 4:

to check the current status of the repository

git status


CMD 5:

to add the files to git index (staging)

git add index.html (to add a single file to index)
git add assets/ (to add a folder to index)
git add -A (to add all the files in the destination folder to index/staging)
git add --all (to add all the files in 1 go)
git add . (adds everything to index)


CMD 6: 

to commit the files to git unmodified area from staging/index

git commit (used to commit all the files in the repo)
git commit -m "commit message" (used to commit and add note in 1 single cmd)
git commit -a -m "commit message" (used to add, commit, and add message in 1 single cmd)

git commit -am "commit message"

CMD 7:

to revert changed of a file to previous commit

git checkout filename.html (to revert changes of a file to previous commit )
git checkout -f (to revert changes of all the files to previous commit )

CMD 8: 

to get the logs

git log (gets all the logs)
git log -p -1 (gets particular number of logs)

CMD 9:

to see the difference of your current working with previous commit

git diff

CMD 10: 

minimalitic status

git status -s

----
Untility feature:

.gitignore (add this file along with files and folders names in your repo to ignore files and folders from git)

CMD 11: 
all about branchs

git branch new-branch-name (creating branch)
git branch (to see all the available branches)
git checkout branch-name (to switch the branch)
git merge branch-name (merge changes into current branch)

CMD 12:

GitHub

git remote add origin remote-link.git (used to create & add new remote)
git push origin master-copy (push the local changes into ur remote repo)
git clone ssh/https-repo-link.git (copying a repo into your machine)
git fetch origin -a (fetch all the changes of the branch)